# Replace example.invalid, certificate paths and the external htpasswd file.
# The control plane data root is private; only public/ serves subscriptions.
server {
    listen 443 ssl;
    server_name example.invalid;
    ssl_certificate /etc/letsencrypt/live/example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.invalid/privkey.pem;
    root /var/lib/mihomo-policy-kit/public;
    autoindex off;
    access_log off;
    log_not_found off;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;

    location = /admin { return 301 /admin/; }
    location /admin/ {
        auth_basic "MPK management";
        auth_basic_user_file /etc/nginx/mpk.htpasswd;
        alias /opt/mihomo-policy-kit/web/dist/;
        try_files $uri $uri/ /admin/index.html;
        add_header Cache-Control "no-store";
    }
    location /api/ {
        auth_basic "MPK management";
        auth_basic_user_file /etc/nginx/mpk.htpasswd;
        client_max_body_size 11m;
        proxy_pass http://127.0.0.1:9292;
        proxy_set_header Host $host;
        # Override client-supplied headers, forward authenticated identity only.
        proxy_set_header X-MPK-Authenticated $remote_user;
        proxy_set_header Authorization "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
        proxy_buffering off;
    }
    location ~ "^/sub/[A-Za-z0-9_-]{20,}/mihomo\.yaml$" {
        auth_basic off;
        access_log off;
        log_not_found off;
        try_files $uri =404;
        default_type application/octet-stream;
        add_header Cache-Control "no-store";
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        limit_except GET HEAD { deny all; }
    }
    location / { return 404; }
}
