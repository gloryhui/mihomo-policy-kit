# Local configuration / secrets
config/config.yaml
.env
.env.*
!.env.example

# User rules
rules/custom.list
rules/private-*.list

# Downloaded upstream provider artifacts
vendor/*
!vendor/.gitkeep

# Generated subscriptions
/dist/*
!/dist/.gitkeep

# Temporary / backup files
*.tmp
*.bak
*.log
.DS_Store
.idea/
.vscode/

# Publisher runtime (V0.2, gitignored: builds / current / previous / tokens / state)
/runtime/*
!/runtime/.gitkeep


# Web control plane and generated assets
/web/node_modules/
/web/dist/
/.bundle/
*.db
*.db-wal
*.db-shm

# Desktop build output
/desktop/src-tauri/target/
/desktop/src-tauri/gen/
/desktop/src-tauri/icons/*
!/desktop/src-tauri/icons/icon.ico
!/desktop/src-tauri/icons/icon.icns
!/desktop/src-tauri/icons/32x32.png
!/desktop/src-tauri/icons/128x128.png
!/desktop/src-tauri/icons/128x128@2x.png
