{
  "name": "mpk-console",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "prettier --check src vite.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "test": "vitest run",
    "desktop:dev": "cd ../desktop && tauri dev",
    "desktop:build": "cd ../desktop && tauri build",
    "desktop:frontend": "vite build --mode desktop",
    "desktop:frontend:dev": "vite --host 127.0.0.1 --mode desktop",
    "desktop:build:windows": "cd ../desktop && tauri build --bundles nsis",
    "desktop:build:macos": "cd ../desktop && tauri build --bundles dmg"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "element-plus": "^2.9.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.0"
  }
}
